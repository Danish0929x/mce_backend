# Copy to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=4000

# MongoDB — ap-south-1 (Mumbai) cluster in production
MONGODB_URI=mongodb://localhost:27017/my_cardamom_estate

# JWT
JWT_SECRET=replace-with-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# WhatsApp Business API (primary OTP channel)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS fallback (when WhatsApp delivery fails)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# Razorpay (subscriptions — ₹4,200/year)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=

# Phase 2 (leave blank for MVP)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENWEATHER_API_KEY=

# ---------- Year-end settlement ----------
# Settlement year start month — OPEN CLIENT QUESTION.
# 1 = calendar year (Jan–Dec), 4 = financial year (Apr–Mar). The brief's
# ₹523.32 average for "2025" matches 4.
SETTLEMENT_YEAR_START_MONTH=1

# ---------- In-app purchase verification ----------
# App Store Server API key (App Store Connect → Users and Access → Integrations).
# Private key is the .p8 contents; use \n for line breaks on one line.
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_BUNDLE_ID=
# Google Play: service account with "View financial data" access in Play Console.
GOOGLE_PLAY_PACKAGE_NAME=com.griffonwebstudios.my_cardamom_estate
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
