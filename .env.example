# Copy to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=4000

# MongoDB — ap-south-1 (Mumbai) cluster in production
MONGODB_URI=mongodb://localhost:27017/my_cardamom_estate

# JWT
JWT_SECRET=replace-with-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# WhatsApp Business API (primary OTP channel)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS fallback (when WhatsApp delivery fails)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# Razorpay (subscriptions — ₹4,200/year)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=

# Phase 2 (leave blank for MVP)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENWEATHER_API_KEY=
